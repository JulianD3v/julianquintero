---
import AboutMe from "@/components/AboutMe.astro"
import Contact from "@/components/Contact.astro"
import Experience from "@/components/Experience.astro"
import Hero from "@/components/Hero.astro"
import Marquee from "@/components/Marquee.astro"
import Projects from "@/components/Projects.astro"
import Stack from "@/components/Stack.astro"
import Layout from "@/layouts/Layout.astro"
import { techMarqueeRow1, techMarqueeRow2 } from "@/data/site"
---

<Layout
  title="Julian Quintero | Desarrollador Web Full-Stack en Medellín"
  description="Portafolio de Julián Quintero, Tecnólogo en Desarrollo de Software y Desarrollador Web Full-Stack. Angular, Laravel, Docker y más. Disponible para freelance y nuevas oportunidades."
>
  <Hero />

  <!-- Carrusel doble de tecnologías con logos oficiales de marca SVG -->
  <section class="relative z-10 flex flex-col gap-2.5 border-y border-line/10 bg-bg/50 py-5 backdrop-blur-md overflow-hidden">
    <Marquee items={techMarqueeRow1} speed={32} />
    <Marquee items={techMarqueeRow2} reverse={true} speed={36} />
  </section>

  <AboutMe />
  <Experience />
  <Projects />
  <Stack />
  <Contact />
</Layout>

<script>
  import { init } from "../scripts/main"

  init()
</script>
