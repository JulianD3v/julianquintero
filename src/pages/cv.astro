---
import "@/styles/fonts.css"

import { about, contact, experience, projects, site, socials, stack } from "@/data/site"

const title = `${site.name} · ${site.title}`

const skills = stack.flatMap((group) =>
  group.items.map((item) => item.name),
)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta
      name="description"
      content={`Hoja de vida de ${site.name}, ${site.role} en ${site.location}.`}
    />
    <meta name="robots" content="index, follow" />
    <link
      rel="preload"
      href="/fonts/onest-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <style is:global>
      :root {
        --c-bg: 255 255 255;
        --c-fg: 15 15 18;
        --c-muted: 90 90 100;
        --c-line: 15 15 18;
        --c-accent: 78 128 10;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      body {
        background: #f4f3ef;
        color: rgb(var(--c-fg));
      }

      @page {
        size: A4;
        margin: 14mm 14mm 12mm;
      }

      @media print {
        body {
          background: #fff;
          font-size: 10.5pt;
          line-height: 1.45;
        }

        [data-no-print] {
          display: none !important;
        }

        section {
          break-inside: avoid;
        }

        h1,
        h2,
        h3 {
          break-after: avoid;
        }

        a {
          color: inherit;
          text-decoration: none;
        }
      }
    </style>
  </head>

  <body class="mx-auto max-w-[52rem] px-6 py-10 antialiased">
    <div
      data-no-print
      class="mb-8 flex flex-wrap items-center justify-between gap-3"
    >
      <a
        href="/"
        class="rounded-full border border-black/10 px-4 py-2 text-sm text-black/60 transition-colors hover:border-black/25 hover:text-black"
      >
        ← Volver al portafolio
      </a>

      <div class="flex items-center gap-2">
        <a
          href={site.cv.pdf}
          download
          data-cursor="PDF"
          class="rounded-full border border-black/15 px-4 py-2 text-sm text-black/70 transition-colors hover:border-black/40 hover:text-black"
        >
          Descargar PDF
        </a>

        <button
          type="button"
          data-print
          class="rounded-full bg-black px-5 py-2 text-sm font-semibold text-white transition-transform hover:scale-[1.02]"
        >
          Imprimir
        </button>
      </div>
    </div>

    <main class="rounded-2xl bg-white p-8 shadow-[0_20px_60px_-40px_rgb(0_0_0/0.4)] print:rounded-none print:p-0 print:shadow-none">
      <header class="border-b border-black/10 pb-6">
        <h1
          class="font-display text-3xl font-bold tracking-tight print:text-[1.7rem]"
        >
          {site.name}
        </h1>
        <p class="mt-1 text-sm text-black/60">
          {site.title} · {site.role}
        </p>
        <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.12em] text-black/50">
          {site.location} · {site.email} · {site.availabilityLabel}
        </p>
        <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-black/50">
          {
            socials.map((social) => (
              <li>
                {social.label}: {social.name}
              </li>
            ))
          }
        </ul>
      </header>

      <section class="mt-7">
        <h2
          class="font-mono text-[11px] uppercase tracking-[0.2em] text-black/45"
        >
          Perfil
        </h2>
        <div class="mt-2 space-y-2 text-[13px]">
          {about.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
        </div>
      </section>

      <section class="mt-7">
        <h2
          class="font-mono text-[11px] uppercase tracking-[0.2em] text-black/45"
        >
          Experiencia
        </h2>

        <ol class="mt-3 space-y-5">
          {
            experience.map((job) => (              <li class="break-inside-avoid">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                  <h3 class="text-[13.5px] font-semibold">
                    {job.title}
                    <span class="font-normal text-black/50"> · {job.company}</span>
                  </h3>
                  <p class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-black/45">
                    {job.date}
                  </p>
                </div>
                <p class="mt-1 text-[12.5px] text-black/75">{job.description}</p>
                <ul class="mt-1.5 list-disc space-y-0.5 pl-4 text-[12px] text-black/65">
                  {job.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="mt-7">
        <h2
          class="font-mono text-[11px] uppercase tracking-[0.2em] text-black/45"
        >
          Proyectos seleccionados
        </h2>

        <ul class="mt-3 grid gap-4 sm:grid-cols-2">
          {
            projects.map((project) => (
              <li class="break-inside-avoid">
                <h3 class="text-[13px] font-semibold">
                  {project.title}
                  <span class="font-normal text-black/50"> · {project.kicker}</span>
                </h3>
                <p class="mt-0.5 text-[12.5px] text-black/75">{project.description}</p>
                <p class="mt-1 font-mono text-[10.5px] uppercase tracking-[0.1em] text-black/45">
                  {project.tags.map((tag) => tag.name).join(" · ")}
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-7">
        <h2
          class="font-mono text-[11px] uppercase tracking-[0.2em] text-black/45"
        >
          Stack
        </h2>
        <p class="mt-2 text-[12.5px] text-black/75">{skills.join(" · ")}</p>
      </section>

      <footer class="mt-8 border-t border-black/10 pt-4 text-[11px] text-black/50">
        <p>
          {contact.lead}
        </p>
        <p class="mt-1">
          {site.email} · {site.location}
        </p>
      </footer>
    </main>

    <p data-no-print class="mx-auto mt-6 max-w-[52rem] text-center text-[11px] text-black/40">
      Este PDF se genera desde <code class="font-mono">/cv</code> con
      <code class="font-mono">npm run cv</code>, así que siempre está sincronizado
      con los datos de <code class="font-mono">src/data/site.ts</code>.
    </p>

    <script is:inline>
      document
        .querySelectorAll("[data-print]")
        .forEach((button) =>
          button.addEventListener("click", () => window.print()),
        )
    </script>
  </body>
</html>
