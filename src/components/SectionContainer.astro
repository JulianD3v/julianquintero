---
interface Props {
  id?: string
  class?: string
  wide?: boolean
}

const { id, class: className = "", wide = false } = Astro.props
---

<section
  id={id}
  data-section={id}
  class={`relative mx-auto w-full scroll-mt-24 px-4 sm:px-6 lg:px-10 ${
    wide ? "max-w-[1680px]" : "max-w-[1400px]"
  } ${className}`}
>
  <slot />
</section>
