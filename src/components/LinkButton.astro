---
interface Props {
  href: string
  variant?: "solid" | "ghost" | "accent"
  class?: string
  target?: string
}

const {
  href,
  variant = "ghost",
  class: className = "",
  target = "_blank",
} = Astro.props

const variants: Record<string, string> = {
  solid: "bg-fg text-bg hover:bg-accent hover:text-accent-contrast",
  ghost: "border border-line/15 text-fg hover:border-accent hover:text-accent",
  accent: "bg-accent text-accent-contrast hover:brightness-110",
}
---

<a
  href={href}
  target={target}
  rel="noopener noreferrer"
  role="link"
  class={`group inline-flex max-w-fit items-center justify-center gap-2 rounded-full px-4 py-2.5 text-sm font-semibold transition-colors duration-300 ${variants[variant]} ${className}`}
>
  <slot />
</a>
