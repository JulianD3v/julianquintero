---
import SunIcon from "./icons/Sun.astro"
import MoonIcon from "./icons/Moon.astro"
import SystemIcon from "./icons/System.astro"

const THEMES = [
  { name: "Claro", value: "light" },
  { name: "Oscuro", value: "dark" },
  { name: "Sistema", value: "system" },
]
---

<div class="relative">
  <button
    type="button"
    id="theme-toggle-btn"
    aria-label="Cambiar tema"
    aria-haspopup="true"
    aria-expanded="false"
    class="relative grid size-9 place-items-center overflow-hidden rounded-full border border-line/10 text-fg transition-colors hover:bg-fg/5"
  >
    <SunIcon class="theme-toggle-icon size-[18px] transition-all" data-theme="light" />
    <MoonIcon
      class="theme-toggle-icon absolute size-[18px] transition-all"
      data-theme="dark"
    />
    <SystemIcon
      class="theme-toggle-icon absolute size-[18px] transition-all"
      data-theme="system"
    />
  </button>

  <div
    id="themes-menu"
    role="menu"
    class="invisible absolute right-0 top-11 z-10 min-w-[9rem] origin-top-right scale-90 rounded-2xl border border-line/10 bg-bg/90 p-1.5 opacity-0 shadow-[0_20px_60px_-20px_rgb(0_0_0/0.35)] backdrop-blur-xl transition-all duration-200"
  >
    <ul>
      {
        THEMES.map((theme) => (
          <li>
            <button
              type="button"
              role="menuitemradio"
              data-theme-option={theme.value}
              class="flex w-full items-center justify-between gap-3 rounded-xl px-3 py-2 text-left text-sm text-muted transition-colors hover:bg-fg/5 hover:text-fg"
            >
              {theme.name}
              <span
                data-theme-check
                class="size-1.5 rounded-full bg-accent opacity-0 transition-opacity"
              />
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .theme-toggle-icon {
    opacity: 0;
    transform: scale(0.4) rotate(-40deg);
  }

  .theme-toggle-icon.is-active {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  #themes-menu.open {
    visibility: visible;
    opacity: 1;
    transform: scale(1);
  }
</style>
