---
import ProjectCard from "./ProjectCard.astro"
import ProjectDetail from "./ProjectDetail.astro"
import TitleSection from "./TitleSection.astro"
import { projects } from "@/data/site"
---

<section
  id="proyectos"
  data-section="proyectos"
  data-horizontal
  class="relative flex flex-col overflow-hidden py-20 sm:py-24 lg:h-[100svh] lg:justify-center lg:py-0"
>
  <div
    class="mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10 xl:max-w-[1560px]"
    data-reveal
  >
    <TitleSection index="03" kicker="Portafolio" title="Proyectos seleccionados" />

    <div
      class="mt-8 flex items-center justify-between gap-4 border-t border-line/10 pt-4 font-mono text-[10px] uppercase tracking-[0.18em] text-muted"
    >
      <p class="flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-accent"></span>
        Desliza horizontalmente
      </p>
      <p data-horizontal-counter class="hidden tabular-nums lg:inline">
        01 / {String(projects.length).padStart(2, "0")}
      </p>
    </div>
  </div>

  <div
    data-horizontal-track
    data-tilt-scope
    class="flex w-full flex-col gap-6 px-4 pt-10 sm:px-6 lg:w-max lg:flex-row lg:gap-8 lg:px-10"
  >
    {
      projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))
    }
  </div>

  <div class="mt-10 hidden px-4 sm:px-6 lg:mt-0 lg:block lg:px-10">
    <div class="h-px w-full overflow-hidden bg-line/10">
      <div
        data-horizontal-progress
        class="h-full w-full origin-left scale-x-0 bg-accent"
      >
      </div>
    </div>
  </div>
</section>

<ProjectDetail projects={projects} />
