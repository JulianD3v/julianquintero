---
import BrandIcon, { type BrandSlug } from "./BrandIcon.astro"
import Vscode from "./icons/Vscode.astro"
import { learning, stack } from "@/data/site"

const SLUGS: Record<string, BrandSlug> = {
  html: "html",
  css: "css",
  javascript: "javascript",
  angular: "angular",
  astro: "astro",
  bootstrap: "bootstrap",
  nextjs: "nextjs",
  laravel: "laravel",
  nodejs: "nodejs",
  java: "java",
  wordpress: "wordpress",
  mysql: "mysql",
  docker: "docker",
  github: "github",
  typescript: "typescript",
  tailwind: "tailwind",
  dotnet: "dotnet",
}
---

{
  stack.map((group, groupIndex) => (
    <article
      data-spotlight
      data-reveal
      class="group/card relative overflow-hidden rounded-[1.5rem] border border-line/10 bg-bg/60 p-6 backdrop-blur-sm transition-colors duration-500 hover:border-accent/30 sm:p-7"
    >
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="font-display text-lg font-semibold tracking-tight">
          {group.title}
        </h3>
        <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted">
          0{groupIndex + 1}
        </span>
      </div>

      <ul data-icon-grid class="mt-6 grid grid-cols-3 gap-x-4 gap-y-5 sm:grid-cols-4">
        {group.items.map((item) => (
          <li data-icon class="group/icon flex flex-col items-center gap-2.5 text-center">
            <span class="grid size-12 place-items-center rounded-2xl border border-line/10 bg-bg-soft transition-all duration-300 group-hover/icon:-translate-y-1 group-hover/icon:border-accent/40 group-hover/icon:bg-bg sm:size-14">
              {item.icon === "vscode" ? (
                <Vscode class="size-6 text-muted transition-colors duration-300 group-hover/icon:text-[#007ACC] sm:size-7" />
              ) : (
                <BrandIcon
                  slug={SLUGS[item.icon]}
                  class="size-6 text-muted transition-all duration-300 group-hover/icon:scale-110 group-hover/icon:text-[var(--brand)] sm:size-7"
                />
              )}
            </span>
            <span class="font-mono text-[10px] uppercase leading-tight tracking-[0.06em] text-muted">
              {item.name}
            </span>
          </li>
        ))}
      </ul>
    </article>
  ))
}

<div
  data-reveal
  class="relative overflow-hidden rounded-[1.5rem] border border-dashed border-accent/30 bg-accent/[0.04] p-6 sm:p-7 lg:col-span-3"
>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <span
        class="relative grid size-2 place-items-center"
        aria-hidden="true"
      >
        <span class="absolute inset-0 animate-ping rounded-full bg-accent/60"></span>
        <span class="size-2 rounded-full bg-accent"></span>
      </span>
      <h3 class="font-display text-lg font-semibold tracking-tight">
        Aprendiendo ahora
      </h3>
    </div>
    <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted">
      Constantemente en formación
    </p>
  </div>

  <ul class="mt-6 flex flex-wrap gap-2.5">
    {
      learning.map((item, index) => (
        <li
          data-float={index * 0.35}
          class="inline-flex items-center gap-2.5 rounded-full border border-line/10 bg-bg/70 py-1.5 pl-1.5 pr-4 text-sm backdrop-blur-sm transition-colors duration-300 hover:border-accent/40"
        >
          <span class="grid size-7 place-items-center rounded-full bg-bg-soft">
            <BrandIcon
              slug={SLUGS[item.icon]}
              class="size-4 text-muted transition-colors duration-300"
            />
          </span>
          {item.name}
        </li>
      ))
    }
  </ul>
</div>
