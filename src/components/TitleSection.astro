---
interface Props {
  title: string
  index?: string
  kicker?: string
  class?: string
  align?: "start" | "center"
}

const {
  title,
  index,
  kicker,
  class: className = "",
  align = "start",
} = Astro.props
---

<div
  class={`flex flex-col gap-5 ${align === "center" ? "items-center text-center" : ""} ${className}`}
>
  {
    (index || kicker) && (
      <p class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.2em] text-muted">
        {index && <span class="text-accent">{index}</span>}
        {index && kicker && <span class="h-px w-10 bg-line/20" aria-hidden="true" />}
        {kicker}
      </p>
    )
  }

  <h2
    data-split="scroll"
    class="font-display text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
  >
    <span class="block overflow-hidden pb-[0.1em] -mb-[0.1em]">
      <span data-split-inner class="block">{title}</span>
    </span>
  </h2>

  <slot />
</div>
