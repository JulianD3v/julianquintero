---
import Link from "./icons/Link.astro"

interface Props {
  title: string
  company: string
  description: string
  link?: string
  date: string
  highlights?: readonly string[]
}

const { title, company, description, link, date, highlights = [] } = Astro.props
---

<article
  class="group relative grid gap-6 border-t border-line/10 py-8 md:grid-cols-[14rem_1fr] md:gap-10 md:py-10 md:pl-8"
>
  <span
    data-timeline-dot
    aria-hidden="true"
    class="absolute -left-[0.5px] top-[2.4rem] hidden size-4 rounded-full border-2 border-accent bg-bg md:block"
  >
  </span>

  <div class="md:sticky md:top-28 md:self-start">
    <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-accent">
      {date}
    </p>
    <h3
      class="mt-2 font-display text-xl font-semibold leading-tight tracking-tight text-balance sm:text-2xl"
    >
      {title}
    </h3>
    <p class="mt-1 flex items-center gap-2 text-sm text-muted">
      {company}
      {
        link && (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visitar ${company}`}
            class="text-muted transition-colors hover:text-accent"
          >
            <Link class="size-3.5" />
          </a>
        )
      }
    </p>
  </div>

  <div class="space-y-5">
    <p class="max-w-2xl text-pretty text-muted">{description}</p>

    {
      highlights.length > 0 && (
        <ul class="flex flex-wrap gap-2">
          {highlights.map((highlight) => (
            <li class="rounded-full border border-line/10 bg-bg/60 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.1em] text-muted">
              {highlight}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
