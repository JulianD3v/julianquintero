<!--
  Efecto de ruido orgánico (Grain Texture) — Guía §5.2.
  Capa fija con feTurbulence, compuesta por GPU (`contain: strict` +
  `translateZ(0)` en performance.css) para que el scroll no provoque repaints.
  El SVG va en un <style> propio porque la data URI no sobrevive al escaneo
  de clases arbitrarias de Tailwind.
-->
<div
  data-grain
  aria-hidden="true"
  class="grain-layer pointer-events-none absolute inset-0 opacity-[0.045] mix-blend-overlay"
>
</div>

<style>
  .grain-layer {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/></filter><rect width='180' height='180' filter='url(%23g)'/></svg>");
    background-size: 180px 180px;
    background-repeat: repeat;
  }
</style>
